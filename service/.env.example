# --- pick exactly one provider -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=us-central1
# OPENAI_BASE_URL=http://localhost:8000/v1     # vLLM / Ollama / gateway

# --- this process's identity when running as an A2A worker ---------------
AGENT_ID=access-control
AGENT_ROLE=lane            # lane | gap | domain | proof | platform | verifier
MODEL_TIER=deep            # triage | deep | verify
PUBLIC_URL=http://localhost:8001

# --- service discovery, read by the orchestrator -------------------------
# One per remote agent. See a2a_client.discover().
AGENT_CARD_URL_ACCESS_CONTROL=http://localhost:8001
AGENT_CARD_URL_ORACLE_EXPERT=http://localhost:8002
AGENT_CARD_URL_EXECUTION_TRACE=http://localhost:8003
AGENT_CARD_URL_ADVERSARIAL_VERIFIER=http://localhost:8004
